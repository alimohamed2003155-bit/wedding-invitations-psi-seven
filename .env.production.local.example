# انسخ الملف ده باسم .env.production.local وحط فيه رابط قاعدة الإنتاج.
#
# ليه ملف مستقل: عشان تشغّل المعاينة والتنضيف على الإنتاج من غير ما
# تلمس .env بتاع التطوير، ومن غير ما الرابط يعدي في سطر الأوامر
# (ويتسجّل في تاريخ الأوامر).
#
# الملف ده متستثنى من git (.gitignore: .env.*.local) — عمره ما يترفع.
#
# ⚠ راجع اسم القاعدة في آخر الرابط كويس: لازم يكون قاعدة الإنتاج
#   (weddingdb) مش التطوير (weddingdb_dev). السكريبت بيطبع الاسم قبل
#   ما يعمل أي حاجة — اقراه قبل ما تكمّل.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/weddingdb?retryWrites=true&w=majority
